<!-- create a route, a controller for this page and render the all the clients here, the clients should be allowed to be added, updated, deleted. -->

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<%- include('../_headers') %>
		<title>Power System Experts</title>
	</head>

	<!-- Navigation Bar -->
	<body class="relative">
		<%- include('../_nav') %>

		<div class="flex justify-center" id="top">
			<a href="/protected/newArticlePage/" class="btn-primary">New Article</a>
		</div>

		<section id="blogs">
			<h1 class="section-main-heading mb-20 animate-on-scroll">BLOGS</h1>

			<div class="flex flex-col justify-start items-center">
				<% articles.forEach(article=>{ %>
				<div
					class="grid grid-rows-[6fr 1fr 1fr 1fr 1fr] md:grid-cols-[6fr 1fr 1fr 1fr 1fr] items-center">
					<h1 class="section-sub-heading !text-left"><%= article.title %></h1>
					<span> <%= article.createdAt.toLocaleDateString() %> </span>

					<div class="flex flex-col md:flex-row justify-center items-center">
						<a class="btn-primary" href="/articles/<%= article.slug %>">view</a>
						<a
							class="btn-secondary"
							href="/protected/editArticle/<%= article.slug %>"
							>edit</a
						>
					</div>
					<div>
						<button
							onclick="openDeleteModal('<%=article.slug%>')"
							class="!text-red-700 inline">
							DELETE
						</button>
					</div>

					<div
						id="<%=article.slug%>"
						class="h-[100vh] max-w-full bg-white fixed top-0 left-0 flex-col justify-center items-center mx-auto hidden"
						style="transform: translate()">
						<p class="p-4">DO YOU REALLY WANT TO DELETE ARTICLE:</p>
						<h2 class="section-sub-heading"><%= article.title%></h2>

						<div class="flex flex-col w-min">
							<form
								action="/protected/delete/<%= article.slug %>?_method=DELETE"
								method="post">
								<!-- <button type="submit" class="!text-red-700">DELETE</button> -->

								<button type="submit" class="!bg-red-700 btn-secondary">
									Yes DELETE IT
								</button>
							</form>
							<button class="btn-primary" onclick="closeDeleteModal()">
								Cancel
							</button>
						</div>
					</div>
				</div>
				<% }) %>
			</div>
		</section>

		<%- include('../_footer') %>
		<script>
			let deleteModal;
			function openDeleteModal(slug) {
				deleteModal = document.getElementById(slug);
				deleteModal.classList.replace("hidden", "flex");
			}
			function closeDeleteModal(slug) {
				deleteModal.classList.replace("flex", "hidden");
				deleteModal = "";
			}
		</script>
	</body>
</html>
