<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('../_headers') %>

		<title>Blog</title>
	</head>
	<body>
		<%- include('../_nav') %>

		<section>
			<h1>New article</h1>
			<!-- Change the action parameter so that it calls a put request -->
			<form
				action="/articles/protected/<%= article.slug %>?_method=PUT"
				method="POST"
				class="flex flex-col justify-center items-center">
				<%- include('_form_field') %>
			</form>
		</section>
		<%- include('../_footer') %>
	</body>
</html>
