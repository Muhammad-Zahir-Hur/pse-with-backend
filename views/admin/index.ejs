<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<%- include('../_headers') %>
		<title>Power System Experts</title>
	</head>

	<!-- Navigation Bar -->
	<body class="relative">
		<%- include('../_nav') %>

		<div class="flex justify-center" id="top">
			<a href="/articles/protected/new/" class="btn-primary marker m-4"
				>New Article</a
			>
		</div>

		<section id="blogs">
			<h1 class="section-main-heading mb-20 animate-on-scroll">BLOGS</h1>

			<div class="flex flex-col justify-start items-center">
				<% articles.forEach(article=>{ %>
				<div
					class="grid grid-rows-[6fr 1fr 1fr 1fr 1fr] md:grid-cols-[6fr 1fr 1fr 1fr 1fr] justify-center items-center">
					<h1 class="section-sub-heading"><%= article.title %></h1>
					<span> <%= article.createdAt.toLocaleDateString() %> </span>

					<a class="btn-primary" href="/articles/<%= article.slug %>">view</a>
					<a
						class="btn-secondary"
						href="/articles/protected/edit/<%= article.slug %>"
						>edit</a
					>
					<button
						onclick="openDeleteModal('<%=article.slug%>')"
						class="!text-red-700">
						DELETE
					</button>

					<div
						id="<%=article.slug%>"
						class="h-[100vh] max-w-full bg-white fixed top-0 left-0 flex-col justify-center items-center mx-auto hidden"
						style="transform: translate()">
						<p class="p-4">DO YOU REALLY WANT TO DELETE ARTICLE:</p>
						<h2 class="section-sub-heading"><%= article.title%></h2>

						<form
							action="/articles/protected/delete/<%= article.slug %>?_method=DELETE"
							method="post">
							<!-- <button type="submit" class="!text-red-700">DELETE</button> -->

							<button type="submit" class="!bg-red-700 btn-secondary">
								Yes DELETE IT
							</button>
						</form>
						<button class="btn-primary" onclick="closeDeleteModal()">
							Cancel
						</button>
					</div>
				</div>
				<% }) %>
			</div>
		</section>

		<%- include('../_footer') %>
		<script>
			let deleteModal;
			function openDeleteModal(slug) {
				deleteModal = document.getElementById(slug);
				deleteModal.classList.replace("hidden", "flex");
			}
			function closeDeleteModal(slug) {
				deleteModal.classList.replace("flex", "hidden");
				deleteModal = "";
			}
		</script>
	</body>
</html>
