<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('../_headers') %>
		<title>PSE:Admin</title>
	</head>
	<body>
		<%- include('../_nav') %>

		<form
			action="/admin"
			method="post"
			class="flex flex-col justify-center items-center"
			id="loginForm">
			<div class="input-div">
				<label for="name">User Name</label>
				<input
					type="text"
					name="name"
					id="name"
					placeholder="User name"
					required />
			</div>

			<div class="input-div">
				<label for="password">Your Password</label>
				<input
					type="password"
					name="password"
					id="password"
					placeholder="Example@abc.com"
					required />
			</div>
			<div class="input-div">
				<button type="submit" id="" class="btn-primary">Send</button>
			</div>
		</form>

